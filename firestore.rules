rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and balances
    match /users/{userId} {
      // Authenticated users can read public stats for leaderboard and circles
      allow read: if isAuthenticated();
      // Only the user themselves can update their profile
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Authoritative ledger transactions (Immutable append-only ledger)
    match /ledger/{txId} {
      // A user can only read their own ledger transactions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow user to write transaction if authenticated and marking it for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Disallow modifications and deletions to preserve ledger immutability
      allow update, delete: if false;
    }

    // Mining Sessions
    match /mining_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Circle Members
    match /circle_members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Referral Records
    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerUid == request.auth.uid || 
        resource.data.inviteeUid == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // User Achievements
    match /user_achievements/{achId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}